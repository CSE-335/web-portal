# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing

# next.js
/.next/
/out/
/.open-next/

# cloudflare
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem
.claude
.swc
*.code-workspace

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace packages (built before publish / on npm install)
/packages/*/dist/

*storybook.log
storybook-static

# game repo cache and generated artifacts
# Cached external game repos synced from games.config.mjs
/.game-sources/
# Legacy local game checkouts kept outside the tracked build flow
/games/
# Built game files served via iframe (copied from each game's dist/)
/public/staticGames/
# Game thumbnails (copied from each game's data/thumbnail.png)
/public/gameThumbnails/
# Game registry auto-generated from cached game repos
/src/data/games.ts
# Build cache for setup-games script (tracks synced repo commit hashes)
.game-build-cache.json
